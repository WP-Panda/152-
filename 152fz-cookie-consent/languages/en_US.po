msgstr "Automatically add a checkbox to standard HTML forms"

msgid "Аналитика"
msgstr "Analytics"

msgid "Анимация"
msgstr "Animation"

msgid "Баннер"
msgstr "Banner"

msgid "Включите HTTPS для защиты данных и cookie согласия."
msgstr "Enable HTTPS to protect data and the consent cookie."

